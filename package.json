{
  "name": "cosynth",
  "version": "0.1.0",
  "private": true,
  "description": "coSynth, an AI-controllable browser wavetable synthesizer (Web Audio + AudioWorklet + WebGL2)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "playwright": "^1.61.1",
    "typescript": "^5.5.4",
    "vite": "^8.1.4",
    "vitest": "^4.1.11",
    "webmcp-types": "^0.1.5"
  },
  "dependencies": {
    "@audio/pitch-yin": "^1.0.5",
    "driver.js": "^1.8.0",
    "lucide": "^1.37.0",
    "micromark": "^4.0.2",
    "pitchy": "^4.1.0"
  }
}
